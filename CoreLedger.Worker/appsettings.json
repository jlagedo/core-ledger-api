{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=core_ledger_db;Username=postgres;Password=postgres"
  },
  "Database": {
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 30,
    "CommandTimeoutSeconds": 30
  },
  "RabbitMQ": {
    "Hostname": "localhost",
    "Port": "5672",
    "Username": "guest",
    "Password": "guest",
    "PrefetchSize": 0,
    "PrefetchCount": 1,
    "QueueDurable": true,
    "QueueExclusive": false,
    "QueueAutoDelete": false
  },
  "B3Import": {
    "BatchSize": 1000
  },
  "TestConnection": {
    "SimulatedProcessingDelayMs": 2000
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/core-ledger-worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
